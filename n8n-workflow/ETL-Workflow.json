    },
    {
      "parameters": {
        "jsCode": "// 1. Ambil data transaksi dari node sebelumnya\nconst transactions = ($input.first().json.resultData) ? $input.first().json.resultData : [];\n\n// 2. Kamus Ambang Batas (Threshold) Water Level\nconst wlMaster = {\n  \"206016005\": { \"name\": \"Majalaya\", \"step1\": 3.81, \"step2\": 4.11, \"step3\": 4.51 },\n  \"206016030\": { \"name\": \"Solokan Jeruk\", \"step1\": 4.21, \"step2\": 4.51, \"step3\": 4.91 },\n  \"206016201\": { \"name\": \"Cirasea\", \"step1\": 3.88, \"step2\": 4.18, \"step3\": 4.58 },\n  \"206026019\": { \"name\": \"Kompl. Radio\", \"step1\": 0.81, \"step2\": 1.11, \"step3\": 1.51 },\n  \"206026028\": { \"name\": \"BBWS Citarum\", \"step1\": 1.96, \"step2\": 2.26, \"step3\": 2.66 },\n  \"206026029\": { \"name\": \"Sapan\", \"step1\": 2.87, \"step2\": 3.17, \"step3\": 3.57 },\n  \"206026201\": { \"name\": \"Cicadas\", \"step1\": 4.23, \"step2\": 4.53, \"step3\": 4.93 },\n  \"206026202\": { \"name\": \"JB. Baleendah\", \"step1\": 3.29, \"step2\": 3.59, \"step3\": 3.99 },\n  \"206026203\": { \"name\": \"Cikapundung kolot\", \"step1\": 3.82, \"step2\": 4.12, \"step3\": 4.52 },\n  \"206026204\": { \"name\": \"Cikeruh Tegalluar\", \"step1\": 1.75, \"step2\": 2.05, \"step3\": 2.45 },\n  \"206026205\": { \"name\": \"Cipamokolan\", \"step1\": 2.69, \"step2\": 2.99, \"step3\": 3.39 },\n  \"206036002\": { \"name\": \"Nanjung\", \"step1\": 3.6, \"step2\": 3.9, \"step3\": 4.3 },\n  \"206036003\": { \"name\": \"Dayeuhkolot\", \"step1\": 5.96, \"step2\": 6.26, \"step3\": 6.66 },\n  \"206036010\": { \"name\": \"Kamasan\", \"step1\": 4.17, \"step2\": 4.47, \"step3\": 4.87 },\n  \"206036201\": { \"name\": \"Citalugtug\", \"step1\": 0.94, \"step2\": 1.24, \"step3\": 1.64 },\n  \"206036202\": { \"name\": \"Ciranjeng\", \"step1\": 5.83, \"step2\": 6.13, \"step3\": 6.53 },\n  \"206036203\": { \"name\": \"JB. Ciseah\", \"step1\": 4.3, \"step2\": 5.47, \"step3\": 5.8 },\n  \"206036204\": { \"name\": \"M.B Muttaqien\", \"step1\": 2.09, \"step2\": 2.39, \"step3\": 2.79 },\n  \"206076201\": { \"name\": \"JB. Cariu Loji\", \"step1\": 7.59, \"step2\": 7.89, \"step3\": 8.29 },\n  \"206076202\": { \"name\": \"SP. Cibeet\", \"step1\": 12.42, \"step2\": 12.54, \"step3\": 12.94 },\n  \"206076203\": { \"name\": \"Cipamingkis\", \"step1\": 8.13, \"step2\": 8.43, \"step3\": 8.83 },\n  \"206076204\": { \"name\": \"Tanjungpura\", \"step1\": 9.12, \"step2\": 9.42, \"step3\": 9.82 },\n  \"206076205\": { \"name\": \"JB. Muara Gembong\", \"step1\": 7.06, \"step2\": 7.36, \"step3\": 7.76 },\n  \"206076206\": { \"name\": \"Cabangbungin\", \"step1\": 8.57, \"step2\": 8.87, \"step3\": 9.27 },\n  \"206076207\": { \"name\": \"Cikao\", \"step1\": 6.88, \"step2\": 7.18, \"step3\": 7.58 },\n  \"206176201\": { \"name\": \"Gempol Ciherang\", \"step1\": 3.64, \"step2\": 3.94, \"step3\": 4.34 },\n  \"206176202\": { \"name\": \"JB. Cilamaya\", \"step1\": 7.36, \"step2\": 7.66, \"step3\": 8.06 },\n  \"206196201\": { \"name\": \"JB. Pantura Ciasem\", \"step1\": 6.93, \"step2\": 7.23, \"step3\": 7.63 },\n  \"206196202\": { \"name\": \"SP. Tanjungsari\", \"step1\": 7.05, \"step2\": 7.35, \"step3\": 7.75 },\n  \"206236201\": { \"name\": \"JB. Cipunagara\", \"step1\": 6.81, \"step2\": 7.11, \"step3\": 7.51 },\n  \"206236202\": { \"name\": \"JB. Sanca\", \"step1\": 7.3, \"step2\": 7.6, \"step3\": 8 },\n  \"206236203\": { \"name\": \"Cibuluh\", \"step1\": 1.86, \"step2\": 2.16, \"step3\": 2.56 }\n};\n\nreturn transactions\n  .filter(item => wlMaster.hasOwnProperty(String(item.wlobscd))) \n  .map(item => {\n    const rawId = String(item.wlobscd);\n    const rawTime = String(item.ymdhm || \"\");\n    \n    // Format Waktu ke ISO\n    let formattedTime = new Date().toISOString();\n    if (rawTime && rawTime.length === 12) {\n      formattedTime = `${rawTime.substring(0,4)}-${rawTime.substring(4,6)}-${rawTime.substring(6,8)}T${rawTime.substring(8,10)}:${rawTime.substring(10,12)}:00Z`;\n    }\n\n    const currentWl = parseFloat(item.wl || 0);\n    const config = wlMaster[rawId];\n    \n    let warningLevel = 0;\n    if (currentWl >= config.step3) warningLevel = 3;\n    else if (currentWl >= config.step2) warningLevel = 2;\n    else if (currentWl >= config.step1) warningLevel = 1;\n\n    return {\n      json: {\n        sensor_id: rawId,\n        sensor_type: \"water_level\",\n        pos_name: config.name,\n        value: currentWl,\n        warning_level: warningLevel,\n        measured_at: formattedTime,\n      }\n    };\n});"
      },
