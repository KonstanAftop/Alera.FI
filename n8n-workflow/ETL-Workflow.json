    {
      "parameters": {
        "jsCode": "// Mengambil array data dari struktur bersarang\nconst inputData = $input.first().json.data;\n\nreturn inputData.map(item => {\n  const rf = item.rainfall;\n  \n  // Klasifikasi warning_level (0-3)\n  let level = 0;\n  if (rf >= 20) level = 3;      // Sangat Lebat\n  else if (rf >= 10) level = 2; // Lebat\n  else if (rf >= 5) level = 1;  // Sedang\n  else level = 0;               // Ringan/Normal\n\n  return {\n    json: {\n      sensor_id: item.deviceId,\n      sensor_type: \"rainfall\", \n      pos_name: item.name,\n      value: rf,\n      warning_level: level,\n      measured_at: item.readingAt\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -432,
        -272
      ],
      "id": "a4cb54be-af7c-44e7-afb1-00c3b1f47454",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "jsCode": "// 1. Ambil array dari properti 'response'\nconst inputData = $input.first().json.response;\n\n// 2. Daftar nama pos yang ingin dikecualikan\nconst excludedNames = [\n  \"PDA SADU\",\n  \"PDA TERAS CIKAPUNDUNG\",\n  \"PCH CIPEUSING\",\n  \"PCH Dampit\",\n  \"PCH CISOMANG\",\n  \"PDA PEUNDEUY\"\n];\n\n// 3. Filter data untuk membuang nama yang ada di daftar exclude, lalu mapping hasilnya\nreturn inputData\n  .filter(item => !excludedNames.includes(item.name)) // Menghapus data jika namanya ada di list\n  .map(item => {\n    const wl = item.waterLevel;\n    const s1 = item.siaga1;\n    const s2 = item.siaga2;\n    const s3 = item.siaga3;\n    \n    // Kalkulasi Warning Level berdasarkan Threshold (0-3)\n    let calculatedLevel = 0; \n    if (s1 !== null && wl >= s1) {\n      calculatedLevel = 3; // Paling Bahaya\n    } else if (s2 !== null && wl >= s2) {\n      calculatedLevel = 2;\n    } else if (s3 !== null && wl >= s3) {\n      calculatedLevel = 1;\n    }\n\n    return {\n      json: {\n        sensor_id: item.deviceId,\n        sensor_type: \"water_level\",\n        pos_name: item.name,\n        value: wl,\n        warning_level: calculatedLevel,\n        measured_at: item.readingAt,\n      }\n    };\n  });"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -432,
        -32
      ],
      "id": "ae5921a1-2c7b-4f80-b94b-d63901fc256f",
      "name": "Code in JavaScript1"
    },
    {
      "parameters": {
        "jsCode": "const inputData = $input.first().json.data;\n\n// 2. Daftar nama pos yang ingin dikecualikan\nconst excludedNames = [\n  \"PDA SADU\",\n  \"PDA TERAS CIKAPUNDUNG\",\n  \"PCH CIPEUSING\",\n  \"PCH Dampit\",\n  \"PCH CISOMANG\"\n];\n\n// 3. Filter data terlebih dahulu, baru lakukan mapping klasifikasi\nreturn inputData\n  .filter(item => !excludedNames.includes(item.name)) // Mengecualikan nama yang ada di daftar\n  .map(item => {\n    const rainfall = item.rainfallLastHour;\n    let level = 0; // Default: Normal\n\n    // Logika Klasifikasi\n    if (rainfall >= 20) {\n      level = 3; // Sangat Lebat\n    } else if (rainfall >= 10) {\n      level = 2; // Sedang\n    } else if (rainfall >= 5) {\n      level = 1; // Ringan\n    } else {\n      level = 0; // Normal / Berawan\n    }\n\n    return {\n      json: {\n        sensor_id: item.deviceId,\n        sensor_type: \"rainfall\",\n        pos_name: item.name,\n        value: rainfall,\n        warning_level: level,\n        measured_at: item.readingAt\n      }\n    };\n  });"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -432,
        192
      ],
      "id": "c1cd9c3a-94f1-4a81-a92e-8e1561c13995",
      "name": "Code in JavaScript2"
    },
    {
      "parameters": {
        "jsCode": "// Mengambil array dari properti 'response'\nconst inputData = $input.first().json.response\n\nreturn inputData.map(item => {\n  const wl = item.waterLevel;\n  const s1 = item.siaga1;\n  const s2 = item.siaga2;\n  const s3 = item.siaga3;\n  \n  // Kalkulasi Warning Level manual berdasarkan threshold siaga\n  let calculatedLevel = 0; \n  if (s1 !== null && wl >= s1) {\n    calculatedLevel = 3; // Siaga 1\n  } else if (s2 !== null && wl >= s2) {\n    calculatedLevel = 2; // Siaga 2\n  } else if (s3 !== null && wl >= s3) {\n    calculatedLevel = 1; // Siaga 3\n  }\n\n  return {\n    json: {\n      // Identifikasi Utama\n      sensor_id: item.deviceId,\n      sensor_type: \"water_level\",\n      pos_name: item.name,\n      \n      // Data Utama\n      value: wl,\n      warning_level: calculatedLevel,\n      measured_at: item.readingAt,\n      \n      \n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -448,
        384
      ],
      "id": "bf8c5bca-ebd8-4731-954f-384a352971c3",
      "name": "Code in JavaScript3"
    },
    {
      "parameters": {
        "jsCode": "// 1. Ambil data transaksi dari node sebelumnya\nconst transactions = ($input.first().json.resultData) ? $input.first().json.resultData : [];\n\n// 2. Kamus Mapping\nconst sensorMaster = {\n      \"206014004\": \"Paseh-Cipaku\",\n      \"206014019\": \"Kertasari\",\n      \"206014032\": \"Cicalengka\",\n      \"206014034\": \"Ancolmekar\",\n      \"206014201\": \"Ciluluk\",\n      \"206014202\": \"BD. Wangisagara\",\n      \"206024008\": \"Meteo-Lembang\",\n      \"206024016\": \"Rancaekek\",\n      \"206024020\": \"Dago Pakar\",\n      \"206024022\": \"Sapan\",\n      \"206024024\": \"Cidurian (Balai ARR)\",\n      \"206024201\": \"Kiarapayung\",\n      \"206024202\": \"Mekarmanik\",\n      \"206024203\": \"Hulu Cidurian\",\n      \"206024204\": \"Cikapundung RS.\",\n      \"206034005\": \"Cisondari-Pasirjambu\",\n      \"206034023\": \"Hantap\",\n      \"206034026\": \"Dayeuhkolot\",\n      \"206034201\": \"Nanjung\",\n      \"206034202\": \"Cimahi\",\n      \"206034203\": \"Cileunca\",\n      \"206034204\": \"Alamendah\",\n      \"206034205\": \"Sarijadi\",\n      \"206054201\": \"Cisokan\",\n      \"206054202\": \"Gunung Halu\",\n      \"206054203\": \"Tagog Apu\",\n      \"206054204\": \"Cinangsi\",\n      \"206054205\": \"Cipanas\",\n      \"206054206\": \"Hulu Cirata\",\n      \"206064201\": \"Cikalong Kulon\",\n      \"206064202\": \"Galumpit\",\n      \"206074201\": \"Cibeet Bendung\",\n      \"206074202\": \"Karang Haur\",\n      \"206074203\": \"Teluk Bango\",\n      \"206074204\": \"Rawamerta\",\n      \"206074205\": \"Kantor Curug\",\n      \"206074206\": \"Pangkalan\",\n      \"206074207\": \"Cipamingkis PJT II\",\n      \"206074208\": \"Buana Jaya\",\n      \"206164201\": \"Talun Jaya\",\n      \"206174201\": \"BD. Barugbug\",\n      \"206174202\": \"Campaka\",\n      \"206194201\": \"Sukamandi\",\n      \"206194202\": \"Kaliangsana\",\n      \"206234201\": \"BD. Salamdarma\",\n      \"206234202\": \"Sanca\",\n      \"206234203\": \"Cibuluh\",\n      \"206234204\": \"Gembor\",\n      \"206274201\": \"Bongas\",\n      \"206024014\": \"Jatiroke-Cikuda\"\n    };\n\n\nreturn transactions.filter(item => sensorMaster.hasOwnProperty(String(item.rfobscd)))\n  .map(item => {\n    const rawId = String(item.rfobscd);\n    const rawTime = String(item.ymdhm || \"\");\n    \n    let formattedTime = new Date().toISOString();\n    \n    if (rawTime && rawTime.length === 12) {\n      const y = rawTime.substring(0,4);\n      const m = rawTime.substring(4,6);\n      const d = rawTime.substring(6,8);\n      const hh = rawTime.substring(8,10);\n      const mm = rawTime.substring(10,12);\n      formattedTime = `${y}-${m}-${d}T${hh}:${mm}:00Z`;\n    }\n\n    const rfRaw = parseFloat(item.rf) || 0;\n    const rfHourly = rfRaw * 6;\n\n    let level = 0;\n    if (rfHourly >= 20) {\n      level = 3; // Sangat Lebat\n    } else if (rfHourly >= 10) {\n      level = 2; // Sedang\n    } else if (rfHourly >= 5) {\n      level = 1; // Ringan\n    } else {\n      level = 0; // Normal\n    }\n\n    return {\n      json: {\n        sensor_id: rawId,\n        sensor_type: \"rainfall\",\n        pos_name: sensorMaster[rawId],\n        value: rfHourly,\n        warning_level: level,\n        measured_at: formattedTime,\n      }\n    };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -432,
