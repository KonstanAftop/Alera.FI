      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst body = raw.body ?? raw;\n\nconst sensor_id = body.sensor_id;\nconst old_level = Number(body.old_level);\nconst new_level = Number(body.new_level);\nconst value = body.value != null ? Number(body.value) : null;\nconst trend_3h = body.trend_3h ?? 'stabil';\nconst measured_at = body.measured_at ?? new Date().toISOString();\n\nif (!sensor_id || Number.isNaN(old_level) || Number.isNaN(new_level)) {\n  throw new Error('Invalid webhook payload: missing sensor_id or levels');\n}\n\nreturn [{\n  json: {\n    sensor_id,\n    old_level,\n    new_level,\n    value,\n    trend_3h,\n    measured_at,\n  },\n}];"
      },
