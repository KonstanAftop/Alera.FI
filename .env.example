# Shared (frontend + backend read from repo root .env when running locally)
VITE_SUPABASE_URL=

# Frontend (Vite) — prefix VITE_ required for exposure to the browser
VITE_SUPABASE_ANON_KEY=
# FastAPI backend (local: http://localhost:8005; production: https://your-backend.onrender.com)
VITE_API_URL=http://localhost:8005

# Backend (FastAPI)
SUPABASE_SERVICE_ROLE_KEY=
TELEGRAM_BOT_TOKEN=
